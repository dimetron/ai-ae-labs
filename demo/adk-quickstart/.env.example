# Налаштування API ключів для різних провайдерів (виберіть потрібний):

# Google Gemini (за замовчуванням): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# або: GOOGLE_API_KEY=your_gemini_api_key_here

# Anthropic (для claude-* моделей): https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (для gpt-* моделей): https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Опційні моделі (автоматично визначає провайдера через pimodels):
# MODEL=gemini-3.7-flash
# MODEL=claude-haiku-4.5
# MODEL=claude-sonnet-5
# MODEL=gpt-5.6-luna
# MODEL=gpt-4o
# MODEL=ollama/deepseek-v4-flash:0731
# MODEL=ollama/llama3

# Опційно: власний Base URL (для проксі, шлюзу або локального сервера):
# BASE_URL=http://localhost:4000/v1
